# Copy to .env and fill in ONE provider.
GEMINI_API_KEY=
# GROQ_API_KEY=
# LLM_PROVIDER=ollama

# Optional overrides
# LLM_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite   # a list: falls over when a daily quota runs out
# LLM_MIN_INTERVAL=6.5     # seconds between calls, to stay under free-tier rate limits
# EXTRACT_WORDS=3000       # transcript words per extraction call
